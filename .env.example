# ─── Contact form delivery (https://resend.com) ───────────────────────────────
# The app builds and runs without these; they are only needed for /api/contact
# to actually deliver mail. Without them the form returns a 502 with a friendly
# message rather than failing the build.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Must be a domain verified in Resend (or onboarding@resend.dev while testing).
MAIL_FROM="Portfolio <contact@yourdomain.com>"

# Where contact-form submissions are delivered.
MAIL_TO=you@example.com


# ─── Optional ─────────────────────────────────────────────────────────────────
# Google Search Console verification token. When unset, no verification meta
# tag is emitted at all (so a placeholder can never ship to production).
# GOOGLE_SITE_VERIFICATION=
